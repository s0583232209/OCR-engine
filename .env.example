# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="PASTE_YOUR_GEMINI_API_KEY_HERE"
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EASYOCR_PYTHON: Path to the Python executable that has EasyOCR installed.
# Defaults to "python" if not set (i.e. whatever "python" resolves to on PATH).
# Set this when using a virtual environment or a non-default Python binary, e.g.:
#   EASYOCR_PYTHON="python3"
#   EASYOCR_PYTHON="/path/to/venv/bin/python"
#   EASYOCR_PYTHON="C:\path\to\venv\Scripts\python.exe"
EASYOCR_PYTHON="python"
